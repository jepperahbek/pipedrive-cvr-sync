# --- Server ---
PORT=3000
NODE_ENV=development

# --- CVR provider (Datafordeler / official CVR register) ---
# Create a free user + IT-system + API key at https://datafordeler.dk
# (Administration). You do NOT need to apply for CVRPerson access for this app.
CVR_PROVIDER=datafordeler
DATAFORDELER_API_KEY=
# Optional override (defaults to https://graphql.datafordeler.dk/CVR/v1)
# DATAFORDELER_GRAPHQL_URL=

# --- Pipedrive (optional — without these, only CVR lookup works) ---
# Personal API token (single-tenant). Settings → Personal preferences → API.
PIPEDRIVE_API_TOKEN=
# Company domain, e.g. "yourco" for yourco.pipedrive.com
PIPEDRIVE_COMPANY_DOMAIN=
# App client secret from the Developer Hub (verifies iframe JWT).
PIPEDRIVE_JWT_SECRET=
# Optional: your Pipedrive company id. When set, the iframe JWT's company id
# must match it (single-tenant guard).
PIPEDRIVE_COMPANY_ID=
# HTTP Basic auth for the auto-sync webhook. REQUIRED for auto-sync — the
# webhook route is not mounted unless both values are set.
PIPEDRIVE_WEBHOOK_USER=
PIPEDRIVE_WEBHOOK_PASSWORD=
# OAuth install-callback (Developer Hub client id/secret). Needed for the
# private app to finish installing so UI extensions activate. Tokens are not
# stored; data operations still use PIPEDRIVE_API_TOKEN.
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=
# Optional explicit OAuth redirect URI; otherwise derived from the request host.
# PIPEDRIVE_OAUTH_REDIRECT_URI=https://your-domain.example/api/oauth/callback
